# com-ai 本地环境变量模板
#
# 这个文件只是模板：docker compose 在没有 .env 时会用 compose 文件里的默认值，
# 所以「一条命令启动」不需要先复制本文件。需要改端口或口令时再复制成 .env。
#
#     cp .env.example .env
#
# .env 已被 .gitignore 排除，任何口令 / 令牌都不要提交。

# ─── 开发库（docker compose 的 postgres 服务）────────────────────────
POSTGRES_USER=comai
POSTGRES_PASSWORD=comai_dev_password
POSTGRES_DB=comai
# 宿主机端口，可按需改（冲突时改成 5434 之类）
POSTGRES_PORT=5432

# ─── 测试库（vitest harness 用它派生每次运行的独立数据库）──────────
TEST_POSTGRES_USER=comai
TEST_POSTGRES_PASSWORD=comai_test_password
TEST_POSTGRES_DB=comai_test
TEST_POSTGRES_PORT=5433

# ─── 应用对外端口 ──────────────────────────────────────────────────
# Next.js 应用直连端口
APP_PORT=3000
# Caddy 反向代理对外端口（浏览器访问 http://localhost:<HTTP_PORT>）
HTTP_PORT=8080

# ─── 运行时数据库连接串 ────────────────────────────────────────────
# compose 会用上面的 POSTGRES_* 变量拼装容器内用的连接串，这里只给
# 「不用 compose、直接本机跑 pnpm dev」的场景用。
DATABASE_URL=postgresql://comai:comai_dev_password@localhost:5432/comai

# ─── 采集器 ───────────────────────────────────────────────────────
# GitHub token（可选，但强烈建议给）：
#   不给 → GitHub API 配额 60 次/小时，批量采集会卡死；
#   给   → 5000 次/小时。
# 怎么拿：& "C:\Program Files\GitHub CLI\gh.exe" auth token
# ⚠️ token 只从环境变量读，绝不写进代码或提交进仓库。
GITHUB_TOKEN=

# 每个数据源一条独立 cron（spec 决策 4：高频源与低频源节奏不同）。
# 5 段 cron 表达式：分 时 日 月 周，时区固定 Asia/Shanghai。
#   榜单（高频源）：每天一次
CRON_SKILLS_SH_LEADERBOARD=17 3 * * *
#   站点地图（低频源）：每周一一次
CRON_SKILLS_SH_SITEMAP=43 3 * * 1
#   三档保留策略：每天一次
CRON_RETENTION=7 4 * * *
#   MCP 官方 registry：每天一次
CRON_MCP_REGISTRY=23 5 * * *

# 单次采集最多回源多少个仓库（限流保护）。
SKILLS_SH_LEADERBOARD_MAX_REPOS=200
SKILLS_SH_SITEMAP_MAX_REPOS=300

# MCP 官方 registry（票 #13）：一轮最多采多少个 server、探测多少个远程 server 的工具。
#   工具定义要跟每个 server 握一次 MCP 握手（慢），所以单独设闸门，
#   超出的留到下一轮（slug 幂等，不会重复入库）。
MCP_MAX_SERVERS=500
MCP_MAX_TOOL_PROBES=200

# 回源 GitHub 的 HTTP 缓存目录与有效期（默认 6 小时）。
COLLECTOR_CACHE_DIR=.cache/collector
COLLECTOR_CACHE_TTL_MS=21600000

# 采集 cron 的开关：设成 false 就完全不启动（开发环境默认不启动）。
COLLECTOR_CRON_ENABLED=false

# ─── 游客态互动（设备指纹 / IP 限流）────────────────────────────────
# 设备指纹与 IP 的哈希密钥（HMAC-SHA256）。
# 不配则退回 DATABASE_URL —— 同样是环境变量、同样不进仓库，
# 保证服务重启后哈希不变（变了 = 游客的设备认不出来了）。
# ⚠️ 主动更换这个值 = 换掉所有游客态身份（旧的设备指纹不再认得出）。
INTERACTION_HASH_SECRET=

# 游客态限流：同一 IP 在时间窗内对**同一资产**的点赞 / 收藏条数上限。
GUEST_RATE_LIMIT_MAX=10
GUEST_RATE_LIMIT_WINDOW_SECONDS=3600

# ─── 认证（邮箱魔法链接 / GitHub OAuth）──────────────────────────────
# 会话 JWT 的签名密钥（HS256）。
# 不配则退回 INTERACTION_HASH_SECRET，再退回 DATABASE_URL ——
# 三样都没有时报错，不给弱默认值。
# ⚠️ 主动更换 = 所有人被登出。
AUTH_SESSION_SECRET=
# 站点对外的绝对地址（生成登录链接与 OAuth 回调地址用）。
# 不配则按请求的 origin 推导；生产环境建议显式配，免得 Host 头被伪造。
AUTH_BASE_URL=
# 会话有效期（秒，默认 30 天）与魔法链接有效期（秒，默认 15 分钟）。
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_MAGIC_LINK_TTL_SECONDS=900
# GitHub OAuth 的 state 有效期（秒，默认 10 分钟）。
AUTH_OAUTH_STATE_TTL_SECONDS=600

# 请求登录链接的防滥用限流：
#   同一邮箱 15 分钟内最多 5 次；同一 IP 1 小时内最多 20 次。
AUTH_RATE_LIMIT_EMAIL_MAX=5
AUTH_RATE_LIMIT_EMAIL_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_IP_MAX=20
AUTH_RATE_LIMIT_IP_WINDOW_SECONDS=3600

# ─── 邮件服务（只用于发登录链接）────────────────────────────────────
# 不配 = 用控制台发送器：链接输出到服务端日志，并在登录页回显（开发模式）。
# 配成 http 时用下面的通用邮件 HTTP 接口（不绑定某一家邮件 SDK）。
#   AUTH_EMAIL_SENDER=http
#   AUTH_EMAIL_API_URL=https://your-mail-api/send
#   AUTH_EMAIL_API_KEY=...
#   AUTH_EMAIL_FROM=no-reply@example.com
AUTH_EMAIL_SENDER=
AUTH_EMAIL_API_URL=
AUTH_EMAIL_API_KEY=
AUTH_EMAIL_FROM=

# ─── GitHub OAuth（备选登录方式）────────────────────────────────────
# 不配 = 页面上禁用 GitHub 登录并说明「未配置」，接口返回 503 —— 绝不崩。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 不配则按 AUTH_BASE_URL 推 /api/auth/github/callback。
GITHUB_OAUTH_REDIRECT_URI=

# ─── 中文简介生成（DeepSeek，OpenAI 兼容协议）──────────────────────
# 生成 Skill / MCP / Prompt 的中文简介初稿（spec 决策 7）。
# 不配 = 简介初稿退回模板文案（source=TEMPLATE），**不阻断发布**。
DEEPSEEK_API_KEY=
# 不配则用 https://api.deepseek.com 与 deepseek-chat。
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# 单次生成的超时（毫秒，默认 20000）。
DEEPSEEK_TIMEOUT_MS=

# ─── 发布内容的自动关键词过滤（票 #11）─────────────────────────────
# 自动过滤命中后，发布记录进「审核中」并下架，等人工抽查。
# 这里是在内置名单之外**追加**关键词（逗号分隔）；内置名单在
# src/lib/publish-keyword-filter.ts 里。
PUBLISH_BLOCKED_KEYWORDS=

