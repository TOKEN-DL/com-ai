# com-ai 本地环境变量模板
#
# 这个文件只是模板：docker compose 在没有 .env 时会用 compose 文件里的默认值，
# 所以「一条命令启动」不需要先复制本文件。需要改端口或口令时再复制成 .env。
#
#     cp .env.example .env
#
# .env 已被 .gitignore 排除，任何口令 / 令牌都不要提交。

# ─── 开发库（docker compose 的 postgres 服务）────────────────────────
POSTGRES_USER=comai
POSTGRES_PASSWORD=comai_dev_password
POSTGRES_DB=comai
# 宿主机端口，可按需改（冲突时改成 5434 之类）
POSTGRES_PORT=5432

# ─── 测试库（vitest harness 用它派生每次运行的独立数据库）──────────
TEST_POSTGRES_USER=comai
TEST_POSTGRES_PASSWORD=comai_test_password
TEST_POSTGRES_DB=comai_test
TEST_POSTGRES_PORT=5433

# ─── 应用对外端口 ──────────────────────────────────────────────────
# Next.js 应用直连端口
APP_PORT=3000
# Caddy 反向代理对外端口（浏览器访问 http://localhost:<HTTP_PORT>）
HTTP_PORT=8080

# ─── 运行时数据库连接串 ────────────────────────────────────────────
# compose 会用上面的 POSTGRES_* 变量拼装容器内用的连接串，这里只给
# 「不用 compose、直接本机跑 pnpm dev」的场景用。
DATABASE_URL=postgresql://comai:comai_dev_password@localhost:5432/comai
