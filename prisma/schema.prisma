// com-ai 数据模型 —— 统一资产主表 + 类型判别列（spec「Implementation Decisions」第 3 节）
//
// #2 落了「地基」：Asset 主表 + contentTier 枚举位 + 检索所需扩展。
// #3 一次建齐：Asset 全字段、三张 1:1 扩展表、版本与依赖、用户与会话、
// 收藏 / 点赞 / 评论 / 举报 / 用户发布 / 用户安装，以及**写入路径上的许可证分层强制执行**。
//
// 许可证分层规则（spec 约束 1）落在两处，规则本身只有一份定义：
//   - src/lib/license-tier.ts —— 纯函数 SPDX id → 内容档位（可单元测试）；
//   - prisma/migrations/**_add_full_data_model/migration.sql 里的触发器 —— 兜底强制执行，
//     绕过服务层直接写库也得到相同结果。

generator client {
  provider = "prisma-client-js"
  // 让迁移 SQL 里带上 CREATE EXTENSION pg_trgm（检索层依赖它）
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // 检索走 Postgres 全文 + pg_trgm（spec 约束 4：一期不用 pgvector / Redis）。
  extensions = [pg_trgm]
}

/// 资产类型：跨类型搜索只查主表，类型差异字段放 1:1 扩展表。
enum AssetKind {
  SKILL
  MCP
  PROMPT
}

/// 内容档位（spec 约束 1：许可证分层必须在写入路径强制执行）。
/// FULL = CC0/MIT/Apache 等允许再分发，可存正文、可生成简介；
/// METADATA_ONLY = 无许可证或限制性许可证，只存元数据与链接，不复制原文。
enum ContentTier {
  FULL
  METADATA_ONLY
}

/// 简介来源：AI 生成 / 人工撰写 / 模板生成。
enum SummarySource {
  LLM
  HUMAN
  TEMPLATE
}

/// 版本来源：上游仓库 commit sha，或平台自己的 semver。
enum VersionOrigin {
  UPSTREAM
  PLATFORM
}

/// 依赖指向的东西是什么。
enum DependencyKind {
  SKILL
  MCP
  PROMPT
  PACKAGE
  HOST
  OTHER
}

/// Prompt 的模态分类。
enum PromptModality {
  TEXT
  IMAGE
  VIDEO
  MUSIC
}

/// 评论状态：自动关键词过滤 → 用户举报 → 人工抽查（spec 决策 11）。
enum CommentStatus {
  /// 正常可见
  VISIBLE
  /// 命中关键词过滤，待人工抽查
  PENDING
  /// 被隐藏（举报成立 / 运营处理）
  HIDDEN
  /// 作者删除
  DELETED
}

/// 一次采集运行的结果（票 #6）。
enum CollectionRunStatus {
  /// 全部成功
  OK
  /// 部分子源失败
  PARTIAL
  /// 整批失败
  FAILED
}

/// 采集告警的级别（票 #6）。
enum CollectionAlertSeverity {
  /// 需要人看一眼
  WARNING
  /// 采集已经不可用
  ERROR
}

/// 举报对象类型。
enum ReportTarget {
  ASSET
  COMMENT
}

/// 举报理由。
enum ReportReason {
  SPAM
  ILLEGAL
  COPYRIGHT
  INFRINGING
  OFFENSIVE
  OTHER
}

/// 举报处理状态。
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// 平台角色。
enum UserRole {
  USER
  MODERATOR
  ADMIN
}

/// 用户发布的审核状态（spec 决策 11：先自动过滤 + 举报 + 抽查，不做全量预审队列）。
///
/// 关键取舍：**新发布默认 PUBLISHED（对外可见）**，不是先进待审队列 ——
/// 单人运营下全量预审会立刻成为瓶颈。只有命中自动关键词过滤、或被用户举报，
/// 才会被下架到 PENDING 等人工抽查。
enum PublishStatus {
  /// 审核中：命中自动关键词过滤或被举报，已下架，等人工抽查。
  PENDING
  /// 已发布：默认状态，对外可见。
  PUBLISHED
  /// 已拒绝：运营判定违规，已下架。
  REJECTED
}

model Asset {
  id   String    @id @default(cuid())
  kind AssetKind
  /// 全站唯一短名（URL 片段）。
  slug String    @unique
  /// 展示名（英文原文名）。
  displayName String
  /// 中文简介。LLM 生成时必须标注「AI 生成，版权归原作者」（spec 约束 2）。
  summaryZh String?
  summarySource SummarySource?
  /// 来源仓库（GitHub）。
  repoOwner String?
  repoName  String?
  repoUrl   String?
  /// SPDX 许可证 id（如 MIT / Apache-2.0）；null = 未声明 → 只能是 METADATA_ONLY。
  /// 写入时由触发器归一化为小写 SPDX id。
  license String?
  /// 内容档位。默认取最严格的 METADATA_ONLY，避免漏判许可证时误存正文。
  /// ⚠️ 该列由数据库触发器按 license 推导并强制覆盖，调用方传入的值不作数。
  contentTier ContentTier @default(METADATA_ONLY)
  /// 资产正文（当前版本原文）。⚠️ 只有 FULL 档位能存；METADATA_ONLY 由触发器强制清空。
  contentBody String?
  /// 上游原始地址（与 repoUrl 区分：repoUrl 指来源仓库，upstreamUrl 指资产本体）。
  upstreamUrl String?
  stars    Int   @default(0)
  installs Int   @default(0)
  /// 热度加权分（spec「纯函数单元测试」之一）。
  heatScore Float @default(0)
  /// 采集源标识（如 skills.sh / smithery）。
  sourceId String?
  publishedAt  DateTime?
  lastSyncedAt DateTime?
  /// 官方认证资产。
  isOfficial Boolean @default(false)
  /// 归档标记（spec 决策 4 的三档保留策略）：
  ///   null = 热（在保留窗口期内，前端可见）；
  ///   非空 = 归档（超期但高热度：**保留于库、前端隐藏**）。
  /// 超期且低热度的条目由保留策略**物理删除**，不会留在这个状态。
  archivedAt DateTime?
  /// 当前版本（上游 commit sha，或用户发布的平台 semver）。
  /// 二期（#16「版本管理与一键更新」）用这一列做「现在装的是哪一版」的判断，
  /// 版本的完整历史在 AssetVersion 表里 —— 一期只留这一列，不做版本管理。
  currentVersion String?
  /// 收藏数 / 点赞数（跨三种 kind 统一计数）。
  favoriteCount Int @default(0)
  likeCount     Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillDetail   SkillDetail?
  mcpDetail     McpDetail?
  promptDetail  PromptDetail?
  versions      AssetVersion[]
  dependenciesFrom AssetDependency[] @relation("AssetDependencyFrom")
  dependenciesTo   AssetDependency[] @relation("AssetDependencyTo")
  favorites     Favorite[]
  likes         Like[]
  comments      Comment[]
  reports       Report[]
  publishedBy   UserPublishedAsset[]
  installedBy   UserInstall[]

  @@index([kind])
  @@index([contentTier])
  @@index([heatScore])
  @@index([sourceId])
  @@index([kind, heatScore])
  @@index([repoOwner, repoName])
  @@index([archivedAt])
  @@map("Asset")
}

/// 采集源的一次运行记录（票 #6）。
///
/// 健康检查端点与「连续失败告警」都看这张表：不需要外部监控系统也能查到
/// 「哪个源上次跑挂了、挂了几次」。
model CollectionRun {
  id String @id @default(cuid())
  /// 采集源标识（配置级），如 "skills.sh:leaderboard"。
  source String
  /// 采集源类型（"skills-sh" / "github-repo"）。
  sourceType String
  /// 本次运行的结果。
  status CollectionRunStatus
  /// 采到的条目数。
  fetched Int @default(0)
  /// 入库成功条数。
  written Int @default(0)
  /// 入库失败条数。
  failed Int @default(0)
  /// 失败的子源（仓库）数量。
  failures Int @default(0)
  /// 失败原因摘要（人类可读）。
  error String?
  /// 本次运行耗时（毫秒）。
  durationMs Int @default(0)
  startedAt DateTime @default(now())
  finishedAt DateTime?

  @@index([source, startedAt])
  @@map("CollectionRun")
}

/// 采集告警记录（票 #6）。
///
/// 解析器失效 / 源结构变更时落一条；健康检查端点把未确认的告警暴露出来。
/// 不依赖任何需要凭据的外部通道（本机没有 SMTP / 钉钉 / 企微凭据）。
model CollectionAlert {
  id String @id @default(cuid())
  /// 出问题的采集源标识。
  source String
  /// 告警级别。
  severity CollectionAlertSeverity
  /// 一句话说清出了什么事。
  message String
  /// 细节（错误信息 / 结构差异说明）。
  detail String?
  /// 触发时的连续失败次数。
  occurrences Int @default(1)
  createdAt DateTime @default(now())
  /// 运维确认时间；null = 还没处理。
  acknowledgedAt DateTime?

  @@index([source, createdAt])
  @@index([acknowledgedAt])
  @@map("CollectionAlert")
}

/// 许可证 → 内容档位的映射表（唯一的事实来源之一，DB 触发器按它分流）。
/// spdxId 一律小写；表里没有的许可 → METADATA_ONLY。
model LicensePolicy {
  /// 归一化后的小写 SPDX id（mit / apache-2.0 / cc0-1.0 ...）。
  spdxId String @id
  /// 该许可对应的内容档位。
  tier ContentTier
  /// 备注：为什么属于这一档。
  note String?

  @@map("LicensePolicy")
}

/// Skill 专属字段（与 Asset 1:1）。
model SkillDetail {
  assetId String @id
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// SKILL.md 的 frontmatter（name / description / license ...）。
  frontmatter Json?
  /// 「何时用」。由原文生成 → METADATA_ONLY 档位强制为空（触发器）。
  whenToUse String?
  /// 「怎么用」。由原文生成 → METADATA_ONLY 档位强制为空（触发器）。
  howToUse String?
  /// 按宿主划分的安装命令，如 { "claude-code": "npx ..." }。
  installCmds Json?
  /// 支持的宿主：claude-code / codex / cursor ...
  hosts String[] @default([])
  /// SKILL.md 在仓库中的相对路径。
  skillPath String?
  /// 额外文件清单（只存元数据，不含文件内容）。
  extraFiles Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("SkillDetail")
}

/// MCP 专属字段（与 Asset 1:1）。
model McpDetail {
  assetId String @id
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// stdio / sse / http
  transport String?
  /// registry 里的规范 server 名（reverse-DNS，如 "io.github.owner/server"）。
  /// ⚠️ 与 `Asset.displayName`（展示名，可能是 registry 的 title）不是一回事。
  serverName String?
  /// registry 给的原始描述。详情页展示；**不进**可检索字段（METADATA_ONLY 档位）。
  serverDescription String?
  /// 来源仓库最近一次推送的时间（GitHub 的 pushed_at）。
  repoPushedAt DateTime?
  /// 本地包声明，如 [{ name, version }]。
  packages Json?
  /// 远端 server 声明。
  remotes Json?
  /// 工具清单 [{ name, description }]。
  tools Json?
  /// 声明的环境变量名（冲突检测用，spec 决策 13）。
  envVars String[] @default([])
  /// 声明的端口（冲突检测用）。
  ports Int[] @default([])
  /// 平台侧的 mcpServers 配置片段。
  configJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("McpDetail")
}

/// Prompt 专属字段（与 Asset 1:1）。
model PromptDetail {
  assetId String @id
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  modality PromptModality @default(TEXT)
  /// 动作描述（f/prompts.chat 的 act 字段）。
  act String?
  /// 提示词正文。⚠️ 只有 FULL 档位能存；METADATA_ONLY 由触发器强制清空。
  promptBody String?
  /// 面向开发者的说明。
  forDevs String?
  /// 贡献者署名。
  contributor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("PromptDetail")
}

/// 资产版本：上游仓库用 commit sha，用户发布的用平台 semver。
model AssetVersion {
  id String @id @default(cuid())
  assetId String
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// 上游 commit sha 或平台 semver。
  version String
  origin VersionOrigin
  changelog String?
  /// 正文快照。⚠️ 只有 FULL 档位能存；METADATA_ONLY 由触发器强制清空。
  snapshot String?
  /// 正文 hash，用于简介生成缓存（spec 决策 7）。
  contentHash String?
  createdAt DateTime @default(now())

  @@unique([assetId, version, origin])
  @@index([assetId, origin])
  @@map("AssetVersion")
}

/// 资产之间的依赖声明（二期「依赖展示」与查表式冲突检测的底座）。
model AssetDependency {
  id String @id @default(cuid())
  fromId String
  toId String
  from Asset @relation("AssetDependencyFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Asset @relation("AssetDependencyTo", fields: [toId], references: [id], onDelete: Cascade)
  kind DependencyKind
  /// 版本约束，如 ">=1.2.0" / "latest"。
  constraint String?
  createdAt DateTime @default(now())

  @@unique([fromId, toId, kind])
  @@index([toId])
  @@map("AssetDependency")
}

model User {
  id String @id @default(cuid())
  /// 邮箱魔法链接登录（spec 决策 10），GitHub OAuth 为辅。
  email String @unique
  emailVerifiedAt DateTime?
  /// argon2 哈希（spec 决策 10）。
  passwordHash String?
  /// GitHub OAuth 登录的用户名。
  githubLogin String? @unique
  displayName String?
  avatarUrl String?
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  favorites       Favorite[]
  likes           Like[]
  comments        Comment[]
  reports         Report[]
  publishedAssets UserPublishedAsset[]
  installs        UserInstall[]

  @@map("User")
}

model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 只存令牌哈希，不存明文。
  tokenHash String @unique
  expiresAt DateTime
  userAgent String?
  /// IP 哈希（游客态限流用，不存明文 IP）。
  ipHash String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("Session")
}

/// 登录令牌用途：邮箱魔法链接 / GitHub OAuth 的 state。
enum LoginTokenPurpose {
  /// 邮箱魔法链接（spec 决策 10 的主登录方式）。
  EMAIL_MAGIC
  /// GitHub OAuth 的 state 参数（备选登录方式）。
  GITHUB_OAUTH
}

/// 一次性登录令牌。邮箱魔法链接与 GitHub OAuth 的 state 共用这张表。
///
/// 三条硬规矩：
///   1. **只存哈希**：明文令牌只在生成那一次出现在内存与链接里，落库的是 SHA-256；
///   2. **一次性**：用掉就写上 usedAt，之后再拿同一个令牌来一律拒绝；
///   3. **有有效期**：expiresAt 过了就拒绝（令牌本身不失效，但没人能拿它换到会话）。
///
/// 这张表同时是「请求登录链接」的限流账本：窗口内发了多少条，按 email / ipHash 数它自己。
model LoginToken {
  id String @id @default(cuid())
  /// 只存令牌哈希，不存明文。
  tokenHash String @unique
  purpose LoginTokenPurpose
  /// 目标邮箱（EMAIL_MAGIC 必填；GITHUB_OAUTH 留空 —— 回调时才知道邮箱）。
  email String?
  /// 过期时刻。过期的令牌一律拒绝。
  expiresAt DateTime
  /// 一次性：用掉就写上时间戳。
  usedAt DateTime?
  /// IP 哈希（限流与审计用，**不存明文 IP**）。
  ipHash String?
  createdAt DateTime @default(now())

  @@index([purpose, email])
  @@index([ipHash, createdAt])
  @@index([expiresAt])
  @@map("LoginToken")
}

/// 收藏。游客态用设备指纹（哈希后的 deviceId），登录后合并到账号。
/// 三种 kind 的资产共用这一张表 —— 收藏挂在 Asset 上，不按 kind 分表。
model Favorite {
  id String @id @default(cuid())
  assetId String
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// 行为主体键：user:<userId> 或 device:<deviceId>。全局唯一键 = assetId + actorKey。
  actorKey String
  /// 已登录时关联的账号（游客态为 null）。
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 游客态设备指纹（哈希后）。
  deviceId String?
  /// 游客态限流用的 IP 哈希（**不存明文 IP**）。登录态为 null。
  ipHash String?
  createdAt DateTime @default(now())

  @@unique([assetId, actorKey])
  @@index([userId])
  @@index([deviceId])
  @@index([assetId, ipHash, createdAt])
  @@map("Favorite")
}

/// 点赞。游客态用设备指纹 + IP 限流，结构与 Favorite 一致。
model Like {
  id String @id @default(cuid())
  assetId String
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actorKey String
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String?
  /// 游客态限流用的 IP 哈希（**不存明文 IP**）。登录态为 null。
  ipHash String?
  createdAt DateTime @default(now())

  @@unique([assetId, actorKey])
  @@index([userId])
  @@index([deviceId])
  @@index([assetId, ipHash, createdAt])
  @@map("Like")
}

/// 评论。必须登录（spec 决策 10）。
model Comment {
  id String @id @default(cuid())
  assetId String
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 回复的父评论（null = 顶层评论）。
  parentId String?
  parent Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  body String
  status CommentStatus @default(VISIBLE)
  /// 命中自动关键词过滤时的原因。
  filteredReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  reports Report[]

  @@index([assetId, createdAt])
  @@index([userId])
  @@index([status])
  @@map("Comment")
}

/// 举报：可举报资产或评论（spec 决策 11）。
model Report {
  id String @id @default(cuid())
  target ReportTarget
  /// target = ASSET 时非空。
  assetId String?
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// target = COMMENT 时非空。
  commentId String?
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// 举报人（游客态可为空）。
  reporterUserId String?
  reporter User? @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)
  reason ReportReason
  detail String?
  status ReportStatus @default(OPEN)
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([assetId])
  @@index([commentId])
  @@map("Report")
}

/// 用户发布的资产（spec 决策 10：发布自己的资产需要登录）。
///
/// 一期（#11）只做「发布 + 自动过滤 + 举报 + 抽查」这条链路；
/// 二期（#16 版本管理、#17 依赖声明）需要的字段**在这一期就留好**，
/// 这样二期上线时是往表里加行 / 改值，不用迁移全表。
model UserPublishedAsset {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId String
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  publishedAt DateTime @default(now())
  /// 发布附言：用户自己写的那段简介原文。
  /// 站内展示的中文简介可能是 AI 初稿（见 Asset.summaryZh），
  /// 用户写的东西永远留在这里，不被 AI 覆盖。
  note String?
  /// 审核状态。新发布默认 PUBLISHED（对外可见，不做全量预审）。
  status PublishStatus @default(PUBLISHED)
  /// 审核意见：运营写给发布者看的话（驳回原因、放行说明）。
  reviewNote String?
  /// 命中自动关键词过滤时的原因。
  filteredReason String?
  /// 累计被举报次数。
  reportedCount Int @default(0)
  /// 最近一次审核的时间。
  reviewedAt DateTime?
  /// 最近一次审核人（运营者的 userId）。
  reviewedBy String?

  // ─── 二期预留（#16 版本管理 / #17 依赖声明）────────────────────────────
  // 这几列一期不消费，只是把位置留好：二期上线时不必迁移全表。

  /// 发布者声明的版本号（平台 semver）。
  /// #16 用它生成 AssetVersion(origin=PLATFORM) 行并做更新对比。
  latestVersion String?
  /// 仓库内依赖清单的相对路径（平台约定的 manifest）。
  /// #17 按这个路径回源解析，落到 AssetDependency。
  manifestPath String?
  /// 依赖清单 / 版本声明的内容 hash。
  /// 内容变了 = 上游有新版本 —— #16/#17 判断「要不要重跑」的依据。
  manifestHash String?
  /// 已解析出的依赖声明原始快照（#17 落 AssetDependency 之前先存这里，便于复算）。
  dependencyManifest Json?

  @@unique([userId, assetId])
  @@index([status])
  @@index([userId, publishedAt])
  /// 检索与列表的「下架过滤」用这个索引：判断一个资产有没有非 PUBLISHED 的
  /// 发布记录时，走索引而不是全表扫（资产量到万级时差很多）。
  @@index([assetId, status])
  @@map("UserPublishedAsset")
}

/// 用户安装清单（跨设备同步安装清单，spec 决策 10）。
model UserInstall {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId String
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// 安装到的宿主（claude-code / codex ...）。
  host String?
  /// 安装时的版本号。
  version String?
  installedAt DateTime @default(now())

  @@unique([userId, assetId])
  @@map("UserInstall")
}
